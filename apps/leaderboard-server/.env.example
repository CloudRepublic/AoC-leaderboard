# Copy to apps/leaderboard-server/.env (git-ignored); Nx loads it for `nx serve`.
# Relative paths are resolved from the workspace root.

# The adventofcode.com `session` cookie. Preferred: a file only you can read:
#   mkdir -p secrets && pbpaste > secrets/aoc.session && chmod 600 secrets/aoc.session
AOC_SESSION_FILE=secrets/aoc.session
# Or the value itself (less safe: visible in the process environment):
# AOC_SESSION=

# Required: the number in your private leaderboard's URL.
AOC_LEADERBOARD_ID=
# AOC_YEAR=2026                     # default: this year from July, last year before
# AOC_REFRESH_SECONDS=900           # minimum 900 (AoC's limit)
# AOC_USER_AGENT=caesar-aoc-leaderboard (contact: you@example.com)
# AOC_CACHE_FILE=tmp/leaderboard-server/cache.json
# STATIC_DIR=dist/apps/leaderboard/browser
# HOST=localhost
# PORT=4251
